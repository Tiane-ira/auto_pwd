{
  "manifest_version": 3,
  "name": "Auto Fill Extension",
  "version": "2.1.0",
  "description": "支持使用XPath进行元素选择和分组数据填充的浏览器插件",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/utils.js",
        "src/content/xpath.js",
        "src/content/picker.js",
        "src/content/filler.js",
        "src/content/key-icon.js",
        "src/content/main.js"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}